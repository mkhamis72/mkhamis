rules_version = '2';

// Two roles (custom claim `role`): student, lecturer. Lecturers need `approved`; admins are lecturers with `admin`.
// Accounts, sessions, attendance and secrets are only written by Cloud Functions (Admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isLecturer() { return signedIn() && request.auth.token.role == 'lecturer'; }
    function isPerson(id) { return signedIn() && request.auth.token.personId == id; }

    match /students/{studentId} {
      allow read: if isPerson(studentId);
      allow write: if false;
    }

    match /staff/{staffId} {
      // Own record, or any record for admins (to list pending lecturers).
      allow read: if isLecturer() && (isPerson(staffId) || request.auth.token.admin == true);
      allow write: if false;
    }

    match /sessions/{sessionId} {
      allow read: if isLecturer() && resource.data.lecturerUid == request.auth.uid;
      allow write: if false;
    }

    match /attendance/{id} {
      allow read: if signedIn()
        && (resource.data.lecturerUid == request.auth.uid || resource.data.studentUid == request.auth.uid);
      allow write: if false;
    }

    // Never readable by any client.
    match /sessionSecrets/{id} { allow read, write: if false; }
    match /deviceUse/{id} { allow read, write: if false; }
  }
}
