rules_version = '2';

// Attendance, sessions and secrets are only ever written by Cloud Functions (Admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isLecturer() { return signedIn() && role() == 'lecturer'; }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isLecturer()
        || (signedIn() && request.auth.token.personId == studentId);
      allow write: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.personId == staffId);
      allow write: if isAdmin();
    }

    match /halls/{hallId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isAdmin()
        || (isLecturer() && resource.data.lecturerUid == request.auth.uid)
        || (signedIn() && request.auth.token.personId in resource.data.studentIds);
      allow write: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isAdmin() || (isLecturer() && resource.data.lecturerUid == request.auth.uid);
      allow write: if false;
    }

    match /attendance/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.lecturerUid == request.auth.uid)
        || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow write: if false;
    }

    // Never readable by any client.
    match /sessionSecrets/{id} { allow read, write: if false; }
    match /deviceUse/{id} { allow read, write: if false; }
  }
}
