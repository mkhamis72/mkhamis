{
  "name": "attendance-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "serve": "npm run build && firebase emulators:start --project demo-attendance",
    "deploy": "firebase deploy --only functions",
    "test:rules": "firebase emulators:exec --only firestore --project demo-attendance \"jest -c jest.rules.config.js\""
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jest": "^29.5.12",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.33.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ]
  }
}
