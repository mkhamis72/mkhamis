{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App (Chrome)",
      "type": "dart",
      "request": "launch",
      "cwd": "app",
      "program": "lib/main.dart",
      "deviceId": "chrome"
    },
    {
      "name": "App (Chrome, emulators)",
      "type": "dart",
      "request": "launch",
      "cwd": "app",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define=USE_EMULATORS=true"
      ]
    },
    {
      "name": "App (device)",
      "type": "dart",
      "request": "launch",
      "cwd": "app",
      "program": "lib/main.dart"
    },
    {
      "name": "App (Android emulator, emulators)",
      "type": "dart",
      "request": "launch",
      "cwd": "app",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=USE_EMULATORS=true",
        "--dart-define=EMULATOR_HOST=10.0.2.2"
      ]
    }
  ]
}
