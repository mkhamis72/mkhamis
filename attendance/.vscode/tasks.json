{
  "version": "2.0.0",
  "tasks": [
    { "label": "functions: test", "type": "shell", "command": "npm test", "options": { "cwd": "${workspaceFolder}/functions" }, "group": "test", "problemMatcher": [] },
    { "label": "functions: typecheck", "type": "shell", "command": "npx tsc --noEmit", "options": { "cwd": "${workspaceFolder}/functions" }, "problemMatcher": ["$tsc"] },
    { "label": "app: analyze", "type": "shell", "command": "flutter analyze && flutter test", "options": { "cwd": "${workspaceFolder}/app" }, "problemMatcher": [] },
    { "label": "app: build web", "type": "shell", "command": "flutter build web", "options": { "cwd": "${workspaceFolder}/app" }, "problemMatcher": [] },
    { "label": "firebase: emulators", "type": "shell", "command": "firebase emulators:start", "options": { "cwd": "${workspaceFolder}" }, "isBackground": true, "problemMatcher": [] },
    {
      "label": "check: all",
      "dependsOrder": "sequence",
      "dependsOn": ["functions: typecheck", "functions: test", "app: analyze", "app: build web"],
      "problemMatcher": []
    }
  ]
}
